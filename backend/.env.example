DATABASE_URL=postgres://localhost:5432/trivia_game
QUESTION_TOKEN_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-different-long-random-string
PORT=4000

# Production-only (set these on Railway, leave unset for local dev):
# NODE_ENV=production
# ALLOWED_ORIGIN=https://your-frontend-domain.up.railway.app

# Optional — only needed for the "Submit Feedback" footer link to actually file a GitHub issue.
# Without these set, feedback submissions are logged server-side and the endpoint returns 503
# rather than silently dropping them. GITHUB_FEEDBACK_TOKEN needs a fine-grained PAT scoped to
# just "Issues: write" on GITHUB_FEEDBACK_REPO — never the classic all-repo token type.
# GITHUB_FEEDBACK_TOKEN=github_pat_...
# GITHUB_FEEDBACK_REPO=your-username/trivia_game
