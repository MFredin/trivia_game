DATABASE_URL=postgres://localhost:5432/trivia_game
QUESTION_TOKEN_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-different-long-random-string
PORT=4000

# Production-only (set these on Railway, leave unset for local dev):
# NODE_ENV=production
# ALLOWED_ORIGIN=https://your-frontend-domain.up.railway.app

# Optional — only needed for the "Submit Feedback" footer link to actually file a GitHub issue.
# Without these set, feedback submissions are logged server-side and the endpoint returns 503
# rather than silently dropping them. GITHUB_FEEDBACK_TOKEN needs a fine-grained PAT scoped to
# just "Issues: write" on GITHUB_FEEDBACK_REPO — never the classic all-repo token type.
# GITHUB_FEEDBACK_TOKEN=github_pat_...
# GITHUB_FEEDBACK_REPO=your-username/trivia_game

# Optional — error tracking. Without it set, Sentry is never initialized: no network calls,
# no console noise, no change to any route's existing error responses. Get a DSN from a free
# sentry.io project and set it on Railway; see docs/monitoring.md.
# SENTRY_DSN=

# Optional — email for "Forgot your password?" and the public account-deletion page. Resend
# (resend.com) sends it; MAIL_FROM must be an address on a domain verified there. Without both,
# nothing is sent in production, and the app hides the password-reset link rather than promise an
# email that will not arrive. APP_URL is the public address of the *frontend*, where the links in
# the message lead; it falls back to ALLOWED_ORIGIN.
# RESEND_API_KEY=
# MAIL_FROM="The Restricted Section <no-reply@your-domain.example>"
# APP_URL=https://your-frontend-domain.up.railway.app
