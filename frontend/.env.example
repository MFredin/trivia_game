# Leave unset for local dev — vite.config.js proxies /api to http://localhost:4000.
# On Railway, set this to the deployed backend service's public URL, including /api, e.g.:
# VITE_API_URL=https://trivia-backend-production.up.railway.app/api
VITE_API_URL=

# Optional — error tracking. Baked in at build time (Vite only forwards VITE_-prefixed vars),
# so it has to be set wherever the production build runs, not just at runtime. Without it set,
# Sentry is never initialized: no network calls, no console noise, no change to how the app
# renders. Get a DSN from a free sentry.io project; see docs/monitoring.md.
# VITE_SENTRY_DSN=
