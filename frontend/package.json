{
  "name": "trivia-game-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-3000}",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit": "npm run audit:contrast && npm run audit:dead",
    "audit:dead": "node scripts/dead-code-audit.mjs",
    "e2e": "node --test --test-concurrency=1",
    "og:image": "node scripts/generate-og-image.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sentry/react": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "vite": "^8.3.3"
  }
}
